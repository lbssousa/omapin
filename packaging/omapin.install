post_install() {
  cat <<'EOF'
==> This package is only the binary. For each user, install the shell
    plugin from the Omarchy plugin marketplace and set omapin up:
      omarchy plugin add https://github.com/lbssousa/omapin.git --enable
      echo 'pinentry-program /usr/bin/omapin' >> ~/.gnupg/gpg-agent.conf
      gpgconf --reload gpg-agent
EOF
}

post_upgrade() {
  echo '==> Update the shell plugin too: omarchy plugin update lbssousa.omapin'
}
